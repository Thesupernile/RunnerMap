<!DOCTYPE HTML>
<html>
    <head>
        <link rel="stylesheet" type="text/css" href="stylesheets/index.css">
        <link rel="stylesheet" type="text/css" href="stylesheets/leaflet.css">
        <link rel="icon" type="img/png" href="images/favicon.png">
        <title>Runner Map</title>
    </head>
    <body>
        <div id="map"></div>
        <div id="sideBar" class="sideBar">
            <h1>Runner Map V0.2.1</h1>
            <br>
            <p>Route Distance:  XXXkm</p>
            <p>Destinations Required:  XXX</p>
            <p>Approximate Time To Run: XXXhrs XXXmins XXXsecs</p>
            <form action="/calculateRoute" method="POST">
                <label>Length Of Route Wanted:</label>
                <input type="text" name="requiredLength" value="<%- locals.requiredLength %>"></input>
                <br>
                <br>
                <label>Round Trip? </label>
                <input type="checkbox" name="roundTrip" value="<%- locals.roundTrip %>"></input>
                <br>
                <br>
                <input type="submit"></input>
            </form>
            <button id="submitButton"> Create Route </button>
            <br>
            <br>
            <p id="ErrorFeedback" style="color: red;" value="<%- locals.errorMessage %>"></p>
            <button id="clearButton">Clear Points</button>

        </div>
    </body>
    <script src="javascripts/webmap.js"></script>
</html>
