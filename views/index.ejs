<!DOCTYPE HTML>
<html>
    <head>
        <link rel="stylesheet" type="text/css" href="stylesheets/index.css">
        <link rel="stylesheet" type="text/css" href="stylesheets/leaflet.css">
        <link rel="icon" type="img/png" href="images/favicon.png">
        <title>Runner Map</title>
    </head>
    <body>
        <div id="map"></div>
        <button id="sideBarButton">></button>
        <div id="sideBar" class="sideBar">
            <h1 style="text-align: center; color: rgb(111, 83, 48);">Runner Map</h1>
            <br>
            <div class="infoBox">
                <p id="distanceBox">Calculated Route Distance:  </p>
                <p id="numPointsBox">Number of Required Destinations:  </p>
                <p id="maxElevationBox"> Maximum Elevation: </p>
                <p id="netElevationBox"> Net Elevation: </p>
                <p id="elevationGainBox"> Elevation Gain: </p>
                <p id="timeBox">Approximate Time To Run: </p>
                <div class="paceInputDiv">
                    <p id="paceDisplay">Pace: 6:00 min/km</p>
                    <input type="range" min="18" max="72" value="36" class="slider" id="paceInput">
                </div>
                <label>Minimum Length? </label>
                <input type="checkbox" id="isMinLengthInput" name="minLength" checked></input>
                <br>
                <br>
                <form action="/calculateRoute" method="POST">
                    <div id="DLSInput" style="display: none;">
                        <label>Length Of Route Wanted (metres): </label>
                        <br>
                        <input type="text" id="requiredLengthInput" name="requiredLength" placeholder="Enter Route Length Here: " ></input>
                        <br>
                        <br>
                    </div>
                    <label>Round Trip? </label>
                    <input type="checkbox" id="isRoundTripInput" name="roundTrip" value="<%- locals.roundTrip %>"></input>
                </form>
                <br>
                <button id="submitButton"> Create Route </button>
                <br>
                <br>
                <button id="clearButton">Clear Points</button>
                <br>
                <br>
                <button id="reverseRouteButton"> Reverse Route Direction </button>
                <p id="ErrorFeedback" style="color: red;" value="<%- locals.errorMessage %>"></p>
            </div>

        </div>
        <div id="loadBox" class="loadBox">
            <p style="text-align: center;">Loading...</p>
            <div style="display: block; position: absolute; left:24%; width:40%">
                <img src="images/RunningMan.gif">
            </div>
        </div>
        
    </body>
    <script src="javascripts/main.js"></script>
</html>
